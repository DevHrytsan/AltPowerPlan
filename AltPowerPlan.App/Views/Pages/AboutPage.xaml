<Page
    x:Class="AltPowerPlan.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:AltPowerPlan.Helpers"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:AltPowerPlan.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:AltPowerPlan.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AboutPage"
    d:DataContext="{d:DesignInstance local:AboutPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="700"
    d:DesignWidth="800"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:ResxLocalizationProvider.DefaultAssembly="AltPowerPlan"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer
        Focusable="False"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        helpers:ScrollViewerHelper.UseReducedScrollSensitivity="True">
        <StackPanel Margin="0,8,16,24" HorizontalAlignment="Stretch">

            <!-- App Header -->
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <Border
                    Margin="0,0,20,0"
                    VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="14"
                            Color="Black"
                            Direction="270"
                            Opacity="0.14"
                            ShadowDepth="2" />
                    </Border.Effect>
                    <Image
                        Width="68"
                        Height="68"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/Assets/icon-1024.png" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="28"
                            FontWeight="Bold"
                            Text="AltPowerPlan" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorSubtleBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
                        </Border>

                        <ui:Button
                            Margin="10,0,0,0"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Appearance="Primary"
                            Icon="{ui:SymbolIcon ArrowDownload24}"
                            Content="{Binding ViewModel.UpdateStatusText, Mode=OneWay}"
                            Command="{Binding ViewModel.OpenUrlCommand}"
                            CommandParameter="{Binding ViewModel.ReleaseUrl, Mode=OneWay}"
                            Visibility="{Binding ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ui:Button
                            Margin="10,0,0,0"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Content="{lex:Loc AboutCheckForUpdates}"
                            Command="{Binding ViewModel.CheckForUpdatesCommand}"
                            Visibility="{Binding ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{lex:Loc AboutAppDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- Collaborators & Contributors Section -->
            <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="18"
                            Symbol="People24" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            Text="{lex:Loc AboutCollaboratorsTitle}" />
                    </StackPanel>
                    <TextBlock
                        Margin="26,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{lex:Loc AboutCollaboratorsSubtitle}" />
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding ViewModel.RefreshCollaboratorsCommand}"
                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                    ToolTip="{lex:Loc AboutCollaboratorsRefresh}" />
            </Grid>

            <!-- Lead Author Card -->
            <ui:CardControl Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Author Avatar with fallback Person icon -->
                        <Border
                            Grid.Column="0"
                            Width="52"
                            Height="52"
                            Margin="0,0,14,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="26"
                            ClipToBounds="True">
                            <Grid>
                                <ui:SymbolIcon
                                    FontSize="24"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Symbol="Person24" />
                                <Image
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding ViewModel.Author.AvatarUrl, Mode=OneWay, FallbackValue={x:Null}}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Author Info -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding ViewModel.Author.DisplayName, Mode=OneWay}" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1"
                                Background="{DynamicResource AccentFillColorSubtleBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Text="{lex:Loc AboutAuthor}" />
                            </Border>
                        </StackPanel>

                        <!-- Open Profile Action -->
                        <ui:Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Appearance="Secondary"
                            Command="{Binding ViewModel.OpenUrlCommand}"
                            CommandParameter="{Binding ViewModel.Author.HtmlUrl, Mode=OneWay}"
                            Icon="{ui:SymbolIcon Open24}"
                            ToolTip="{lex:Loc AboutViewProfile}" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Loading State -->
            <ui:CardControl
                Margin="0,0,0,16"
                Visibility="{Binding ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:CardControl.Header>
                    <StackPanel
                        Margin="12"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:ProgressRing
                            Margin="0,0,12,0"
                            IsIndeterminate="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{lex:Loc AboutCollaboratorsLoading}" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Collaborators List (When Contributors Exist) -->
            <StackPanel
                Visibility="{Binding ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                <ItemsControl
                    ItemsSource="{Binding ViewModel.Collaborators, Mode=OneWay}"
                    Visibility="{Binding ViewModel.HasCollaborators, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CollaboratorModel}">
                            <ui:CardAction
                                Margin="0,0,0,8"
                                Command="{Binding DataContext.ViewModel.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=local:AboutPage}}"
                                CommandParameter="{Binding HtmlUrl}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Collaborator Avatar -->
                                    <Border
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="20"
                                        ClipToBounds="True">
                                        <Grid>
                                            <ui:SymbolIcon
                                                FontSize="20"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Symbol="Person24" />
                                            <Image
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="{Binding AvatarUrl, FallbackValue={x:Null}}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Collaborator Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}" />
                                            <Border
                                                Margin="8,0,0,0"
                                                Padding="6,1"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Role}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ContributionsText}" />
                                    </StackPanel>

                                    <!-- Arrow Icon -->
                                    <ui:SymbolIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Symbol="ChevronRight16" />
                                </Grid>
                            </ui:CardAction>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State (When No Additional Collaborators Yet) -->
                <ui:CardControl
                    Margin="0,0,0,16"
                    Visibility="{Binding ViewModel.HasCollaborators, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                FontSize="28"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Symbol="PeopleAdd24" />

                            <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Text="{lex:Loc AboutCollaboratorsEmpty}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ui:Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Appearance="Primary"
                                Command="{Binding ViewModel.OpenUrlCommand}"
                                CommandParameter="https://github.com/DevHrytsan/AltPowerPlan"
                                Content="{lex:Loc AboutCollaboratorsContributeButton}"
                                Icon="{ui:SymbolIcon Code24}" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>
            </StackPanel>

            <!-- Repository & Issue Links -->
            <TextBlock
                Margin="0,4,0,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{lex:Loc AboutLinksRepo}" />

            <StackPanel Margin="0,0,0,16">
                <ui:CardAction
                    Margin="0,0,0,8"
                    Command="{Binding ViewModel.OpenUrlCommand}"
                    CommandParameter="https://github.com/DevHrytsan/AltPowerPlan"
                    Icon="{ui:SymbolIcon Code24}">
                    <StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="GitHub" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{lex:Loc AboutLinksRepo}" />
                    </StackPanel>
                </ui:CardAction>

                <ui:CardAction
                    Command="{Binding ViewModel.OpenUrlCommand}"
                    CommandParameter="https://github.com/DevHrytsan/AltPowerPlan/issues"
                    Icon="{ui:SymbolIcon Bug24}">
                    <StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{lex:Loc AboutLinksIssues}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{lex:Loc AboutLinksReport}" />
                    </StackPanel>
                </ui:CardAction>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
