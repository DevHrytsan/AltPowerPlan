<Window
    x:Class="AltPowerPlan.Views.Windows.PowerFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:AltPowerPlan.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Power Mode"
    Width="330"
    SizeToContent="Height"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:ResxLocalizationProvider.DefaultAssembly="AltPowerPlan"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    mc:Ignorable="d">

    <Window.Resources>
        <!-- Windows 10 Sharp Button Style -->
        <Style x:Key="Win10ItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="ItemBorder" Property="Padding" Value="13,9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveIndicatorStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Windows 10 Flyout Container: Sharp Corners (CornerRadius 0), 1px solid border -->
    <Border
        x:Name="FlyoutBorder"
        Margin="12"
        Background="#1F1F1F"
        BorderBrush="#383838"
        BorderThickness="1"
        CornerRadius="0">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Direction="270"
                Opacity="0.45"
                ShadowDepth="3" />
        </Border.Effect>

        <StackPanel>
            <!-- Windows 10 Flyout Header -->
            <Grid Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon
                        Symbol="BatteryCharge24"
                        FontSize="18"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        x:Name="HeaderTitle"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Text="{lex:Loc TrayQuickMenuTitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border
                        x:Name="BatteryBadge"
                        Margin="0,0,8,0"
                        Padding="6,2"
                        CornerRadius="4"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                x:Name="BatteryBadgeIcon"
                                Symbol="BatteryCharge24"
                                FontSize="12"
                                Margin="0,0,4,0"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="BatteryBadgeText"
                                FontSize="11"
                                FontWeight="Medium"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="100%" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        x:Name="HeaderPlanName"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <Rectangle
                x:Name="Separator1"
                Height="1"
                Margin="12,0,12,6"
                Fill="#2C2C2C" />

            <!-- Power Modes List -->
            <ItemsControl
                x:Name="PlansItemsControl"
                Margin="0,2,0,4"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                KeyboardNavigation.TabNavigation="Cycle">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PowerPlanModel}">
                        <Button
                            Style="{StaticResource Win10ItemButtonStyle}"
                            Click="OnPlanItemClicked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Symbol="{Binding Icon}" />

                                <!-- Plan Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Windows 10 Active Indicator: Checkmark in accent circle/square -->
                                <Grid
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ActiveIndicatorStyle}">
                                    <ui:SymbolIcon
                                        FontSize="16"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Symbol="Checkmark24" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle
                x:Name="Separator2"
                Height="1"
                Margin="12,2,12,0"
                Fill="#2C2C2C" />

            <!-- Windows 10 Settings Link Footer -->
            <Button
                x:Name="OpenAppButton"
                Style="{StaticResource Win10ItemButtonStyle}"
                Click="OnOpenAppClicked">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Open24" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="{lex:Loc TrayOpenWindow}" />

                    <ui:SymbolIcon
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="ChevronRight16" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
